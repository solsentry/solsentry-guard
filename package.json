{
  "name": "@solsentry/guard",
  "version": "0.0.1",
  "description": "Pre-signing risk checks for Solana transactions — show users who they're about to trust, before they sign.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloak": {
      "types": "./dist/cloak/index.d.ts",
      "import": "./dist/cloak/index.js"
    },
    "./zcash": {
      "types": "./dist/zcash/index.d.ts",
      "import": "./dist/zcash/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "wallet",
    "security",
    "transaction",
    "pre-sign",
    "drainer",
    "risk",
    "solsentry"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@cloak.dev/sdk": "^0.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@cloak.dev/sdk": "^0.2.5"
  },
  "peerDependenciesMeta": {
    "@cloak.dev/sdk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solsentry/solsentry-guard.git"
  },
  "homepage": "https://github.com/solsentry/solsentry-guard#readme",
  "bugs": {
    "url": "https://github.com/solsentry/solsentry-guard/issues"
  }
}
